# Backend API URL
# Development: leave empty to use Vite proxy
# Production: set to your backend URL (e.g., https://api.leadflow.com)
VITE_API_URL=

# Paddle (EE. UU. y resto del mundo). Sin token y precio solo se ofrece dLocalGo
VITE_PADDLE_ENV=sandbox
# Client-side token (es público)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID=
